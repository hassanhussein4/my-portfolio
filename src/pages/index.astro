---
import Layout from '../components/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section style="
    padding: 4rem 2rem;
    max-width: 900px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
  ">
    <h1 style="font-size: 3rem; font-weight: 700; margin-bottom: 0.5rem;">
      Hi, I'm Hassan Hussein
    </h1>
    <p style="font-size: 1.5rem; color: #2563eb; font-weight: 500;">
      System Engineer &amp; Network Architect
    </p>
    <p style="font-size: 1.1rem; line-height: 1.6; max-width: 600px; color: #4a4a4a;">
      Building reliable, scalable infrastructure and embedded systems.
    </p>
  </section>

  <!-- Work Experience -->
  <section id="work" style="
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
  ">
    <h2 style="font-size: 2rem; font-weight: 600; margin-bottom: 1.5rem;">Experience</h2>
    
    <article style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 0.25rem;">
        Senior Network Engineer
      </h3>
      <p style="font-weight: 500; color: #2563eb; margin-bottom: 0.5rem;">
        [Your Company] — 2022 – Present
      </p>
      <ul style="list-style: disc; padding-left: 1.5rem; line-height: 1.6;">
        <li>Designed and implemented scalable network infrastructure.</li>
        <li>Managed cloud infrastructure (AWS, Cloudflare).</li>
        <li>Reduced latency by 30% through network optimization.</li>
      </ul>
    </article>

    <article style="margin-bottom: 2rem;">
      <h3 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 0.25rem;">
        System Architect
      </h3>
      <p style="font-weight: 500; color: #2563eb; margin-bottom: 0.5rem;">
        [Your Company] — 2019 – 2022
      </p>
      <ul style="list-style: disc; padding-left: 1.5rem; line-height: 1.6;">
        <li>Architected embedded systems for industrial automation.</li>
        <li>Led a team of 5 engineers on firmware development.</li>
        <li>Improved system reliability by 25%.</li>
      </ul>
    </article>
  </section>

  <!-- Skills Section -->
  <section id="skills" style="
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
  ">
    <h2 style="font-size: 2rem; font-weight: 600; margin-bottom: 1.5rem;">Skills</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Network Design & Security</span>
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Cloud Infrastructure (AWS, Cloudflare)</span>
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Embedded Systems (C/C++, RTOS)</span>
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Python & Automation</span>
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Linux System Administration</span>
      <span style="background: #e5e7eb; padding: 0.5rem 1.5rem; border-radius: 20px;">Network Routing & Switching</span>
    </div>
  </section>

  <!-- FAQ Section - Essential for AI Engines -->
  <section id="faq" style="
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
  ">
    <h2 style="font-size: 2rem; font-weight: 600; margin-bottom: 1.5rem;">FAQ</h2>
    
    <article style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.25rem;">
        What industries have you worked in?
      </h3>
      <p style="line-height: 1.6; color: #4a4a4a;">
        I've worked in automotive, industrial automation, and consumer electronics.
      </p>
    </article>
    
    <article style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.25rem;">
        What is your core tech stack?
      </h3>
      <p style="line-height: 1.6; color: #4a4a4a;">
        C/C++, Python, Rust, RTOS, ARM Cortex-M microcontrollers, and cloud infrastructure (AWS, Cloudflare).
      </p>
    </article>

    <article style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.25rem;">
        Are you available for freelance projects?
      </h3>
      <p style="line-height: 1.6; color: #4a4a4a;">
        Yes! I'm open to freelance and consulting opportunities. Contact me at <a href="mailto:your@email.de" style="color: #2563eb; text-decoration: none;">your@email.de</a>.
      </p>
    </article>
  </section>

  <!-- Contact Section -->
  <section id="contact" style="
    padding: 2rem;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
    border-top: 1px solid #e5e7eb;
    margin-top: 2rem;
  ">
    <h2 style="font-size: 2rem; font-weight: 600; margin-bottom: 1rem;">Let's Connect</h2>
    <p style="font-size: 1.1rem; color: #4a4a4a; margin-bottom: 1rem;">
      Have a project in mind? Let's talk!
    </p>
    <a href="mailto:your@email.de" style="
      display: inline-block;
      background: #2563eb;
      color: white;
      padding: 0.75rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      transition: background 0.2s;
    ">
      Get in Touch
    </a>
  </section>
</Layout>