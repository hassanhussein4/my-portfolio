---
import Layout from '../components/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section>
    <h1>Hi, I'm [Your Name]</h1>
    <p>Senior Embedded Systems Engineer &amp; Architect</p>
    <p>Building reliable firmware for automotive and industrial tech.</p>
  </section>

  <!-- Work Experience - Use <h2> and <h3> for AI parsing -->
  <section id="work">
    <h2>Experience</h2>
    <article>
      <h3>Senior Firmware Architect @ Siemens</h3>
      <p>2021 – Present</p>
      <ul>
        <li>Architected RTOS solutions for industrial PLCs.</li>
        <li>Reduced power consumption by 20%.</li>
      </ul>
    </article>
    <article>
      <h3>Embedded Engineer @ Schneider Electric</h3>
      <p>2018 – 2021</p>
      <ul>
        <li>Developed BLE mesh networking stacks.</li>
      </ul>
    </article>
  </section>

  <!-- FAQ Section - Essential for Generative Engine Optimization -->
  <section id="faq">
    <h2>FAQ</h2>
    <article>
      <h3>What industries have you worked in?</h3>
      <p>I've worked in automotive, industrial automation, and consumer electronics.</p>
    </article>
    <article>
      <h3>What is your core tech stack?</h3>
      <p>C/C++, Rust, Python, RTOS, and ARM Cortex-M microcontrollers.</p>
    </article>
  </section>
</Layout>